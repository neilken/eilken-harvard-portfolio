# ============================================================================
# Google Cloud Configuration
# ============================================================================
# Your GCP project ID
VERTEX_PROJECT_ID=ac215-476420
# GCP region (e.g., us-central1, us-east1, europe-west1)
VERTEX_REGION=us-central1

# ============================================================================
# Google Cloud Authentication
# ============================================================================
# Note: When using Docker, credentials are copied from secrets/gcs-key.json during build
# The path in the container will be: /workspace/credentials.json
# Credentials are baked into the image (no volume mounts needed)
GOOGLE_APPLICATION_CREDENTIALS=/workspace/credentials.json

# ============================================================================
# RAG API Configuration
# ============================================================================
# URL of the RAG service
# For Docker containers on same network: http://rag-service:9000
# For Docker containers connecting to host: http://host.docker.internal:9000
# For local development: http://localhost:9000
RAG_API_URL=http://rag-service:9000
# RAG API request timeout in seconds
RAG_API_TIMEOUT=10

# ============================================================================
# Gradio Configuration (optional)
# ============================================================================
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860
GRADIO_SHARE=false

# ============================================================================
# Logging
# ============================================================================
# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

