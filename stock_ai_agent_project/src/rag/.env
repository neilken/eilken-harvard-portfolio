# --- AC215 MS3 Semantic RAG (.env) ---

# # Vector store (Chroma)
VECTOR_STORE_PATH=/workspace/volumes/chroma
VECTOR_COLLECTION=stocks_rag_v1

# Data + artifacts (baked into container or mounted)
DATA_DIR=/workspace/data
ARTIFACTS_DIR=/workspace/artifacts

# Ingestion settings
#CHUNK_SIZE=1200
#CHUNK_OVERLAP=200
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Performance tuning
EMBED_BATCH=256      # Embedding batch size
UPSERT_BATCH=256     # ChromaDB upsert batch size
ENABLE_CACHE=1       # Enable query/embedding caching (0=disabled, 1=enabled)
CACHE_SIZE=1000      # Maximum cache entries

# API settings
API_HOST=0.0.0.0
API_PORT=8000

# Disable telemetry
CHROMA_TELEMETRY_DISABLED=1

# GCS Storage (optional - for persistent vector storage without mounts)
# To use GCS: fill in bucket name and set USE_GCS_STORAGE=1
USE_GCS_STORAGE=1     # Set to 1 to enable GCS storage
GCS_BUCKET_NAME=ac215-chroma-bucket  # Bucket name for ChromaDB vectors
GCS_PATH_PREFIX=chromadb  # Path prefix in bucket for vector store
GCS_BUCKET_LOCATION=us-central1  # Region for auto-created buckets (options: us-central1, us-east1, europe-west1, etc.)
GCP_PROJECT_NUMBER=ac215-476420  # Your GCP project number
GCS_SERVICE_ACCOUNT_KEY=gcs-key.json  # Service account JSON key file path (relative to /workspace in Docker)

# Ingestion behavior
SKIP_EXISTING=0  # Set to 1 to skip already processed documents (faster re-runs)



