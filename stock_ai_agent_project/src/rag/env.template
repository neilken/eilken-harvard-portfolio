# AC215 Semantic RAG - Environment Variables Template
# Copy this file to .env and fill in your values
#
# REQUIRED variables:
#   - GCS_BUCKET_NAME: GCS bucket name for ChromaDB persistence (REQUIRED)
#   - GOOGLE_APPLICATION_CREDENTIALS: Path to GCS credentials (set automatically in Docker)
#
# All other variables have sensible defaults and are optional.

# ============================================================================
# Google Cloud Configuration
# ============================================================================
# Your GCP project number (optional, for bucket creation)
# Get from: gcloud projects describe stock-busters-cs115 --format="value(projectNumber)"
# GCP_PROJECT_NUMBER=your-project-number-here

# Google Cloud Authentication
# Note: When using Docker, credentials are copied from secrets/gcs-key.json during build
# The path in the container will be: /workspace/gcs-key.json
# Credentials are baked into the image (no volume mounts needed)
GOOGLE_APPLICATION_CREDENTIALS=/workspace/gcs-key.json

# ============================================================================
# Vector Store (ChromaDB)
# ============================================================================
# ChromaDB collection name
VECTOR_COLLECTION=stocks_rag_v1

# ChromaDB HTTP Client settings
# ChromaDB server host (localhost when running in same container)
CHROMADB_HOST=localhost
# ChromaDB server port (internal)
CHROMADB_PORT=8000
# Optional authentication token (leave empty if not using auth)
CHROMADB_AUTH_TOKEN=
# ChromaDB server data directory (synced with GCS using Python client)
CHROMADB_SERVER_DATA_PATH=/chroma

# Auto-start ChromaDB server (when GCS_BUCKET_NAME is set)
# Set to 0 to disable auto-start (default: 1)
AUTO_START_CHROMADB=1

# Disable telemetry
CHROMA_TELEMETRY_DISABLED=1

# ============================================================================
# Data and Artifacts
# ============================================================================
# Data directory (baked into container or mounted)
DATA_DIR=/workspace/data
# Artifacts directory (for storing metadata, summaries, etc.)
ARTIFACTS_DIR=/workspace/artifacts

# ============================================================================
# Embedding Model
# ============================================================================
# Embedding model to use
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ============================================================================
# Ingestion Settings
# ============================================================================
# Set to 1 to skip already processed documents (faster re-runs)
SKIP_EXISTING=1

# Enable section filtering (only include pages with Part/Chapter headers)
# Set to 0 to disable (default: 1)
ENABLE_SECTION_FILTER=1

# Optional: Override default chunking parameters
# CHUNK_SIZE=1200
# CHUNK_OVERLAP=200

# ============================================================================
# Performance Tuning
# ============================================================================
# Embedding batch size
EMBED_BATCH=256
# ChromaDB upsert batch size
UPSERT_BATCH=256
# Enable query/embedding caching (0=disabled, 1=enabled)
ENABLE_CACHE=1
# Maximum cache entries
CACHE_SIZE=1000

# ============================================================================
# API Settings
# ============================================================================
# API host (0.0.0.0 to accept connections from any interface)
API_HOST=0.0.0.0
# API port (9000 to avoid conflict with ChromaDB server on 8000)
API_PORT=9000

# ============================================================================
# GCS Storage (GCS Python Client for ChromaDB Persistence)
# ============================================================================
# Bucket name for ChromaDB vectors (REQUIRED)
# ChromaDB data will be synced to/from this bucket using GCS Python client
# For stock-busters-cs115 project, use: stock-busters-chroma-bucket (or create your own)
GCS_BUCKET_NAME=stock-busters-chroma-bucket
# Region for auto-created buckets (options: us-central1, us-east1, europe-west1, etc.)
GCS_BUCKET_LOCATION=us-central1

